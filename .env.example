MODE=development
CORS_ORIGIN=http://localhost:8000
AUTH_DATABASE_URL="postgres://<user>:<password>@localhost:5432/bittuly_auth"
URL_DATABASE_URL="postgres://<user>:<password>@localhost:5433/bittuly_urls"
REDIS_URL="redis://127.0.0.1:6379"
RABBITMQ_URL="amqp://<user>:<password>@127.0.0.1:5672"
AUTH_HOST="0.0.0.0"
URL_HOST="0.0.0.0"
AUTH_PORT=3001
URL_PORT=3002
RUST_LOG=tower_http=debug,auth_service=info,url_service=info,consumer_service=info,shared=info

# Generate a secure JWT secret with: openssl rand -base64 32
JWT_SECRET="<your-256-bit-random-secret>"

# Gmail App Password (Settings → Security → 2FA → App Passwords)
SMTP_USER="<your-gmail>@gmail.com"
SMTP_PASS="<your-gmail-app-password>"

# Optional: PostgreSQL pool tuning
# DB_MAX_CONNECTIONS=20
# DB_CONNECT_TIMEOUT_SECS=5
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
